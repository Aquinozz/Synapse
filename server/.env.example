# Copie para .env e ajuste. O .env não vai para o git.

# Porta da API em desenvolvimento
PORT=4000

# Postgres. Em produção (Vercel), use a URL do Neon com "-pooler" no host.
# Sem esta variável, a API roda um Postgres embutido com os arquivos em server/data/pg,
# então não é preciso instalar banco para desenvolver.
# DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

# Senha das contas de demonstração criadas por `npm run seed`
SEED_PASSWORD=synapse-demo-2026

# Código que os funcionários da empresa de demonstração usam para se cadastrar
SEED_COMPANY_CODE=DEMO-2026
